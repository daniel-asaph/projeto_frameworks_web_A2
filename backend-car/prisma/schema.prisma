generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StatusLocacao {
  ATIVA
  FINALIZADA
}

model Usuario {
  id           Int       @id @default(autoincrement())
  nome         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(150)
  senha        String    @db.VarChar(255)
  dataCadastro DateTime  @default(now())
  locacoes     Locacao[]
}

model Veiculo {
  id              Int       @id @default(autoincrement())
  marca           String    @db.VarChar(50)
  modelo          String    @db.VarChar(80)
  placa           String    @unique @db.VarChar(10)
  ano             Int
  valorDiaria     Decimal   @db.Decimal(10, 2)
  disponibilidade Boolean   @default(true)
  locacoes        Locacao[]
}

model Locacao {
  id                    Int           @id @default(autoincrement())
  dataInicio            DateTime
  dataDevolucaoPrevista DateTime
  dataDevolucaoEfetiva  DateTime?
  valorTotal            Decimal       @db.Decimal(10, 2)
  status                StatusLocacao @default(ATIVA)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  veiculoId Int
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([usuarioId, status])
  @@index([veiculoId, status])
}
