generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int       @id @default(autoincrement())
  nome         String
  email        String    @unique
  senha        String
  dataCadastro DateTime  @default(now())
  locacoes     Locacao[]
}

model Veiculo {
  id             Int       @id @default(autoincrement())
  marca          String
  modelo         String
  placa          String    @unique
  ano            Int
  valorDiaria    Float
  disponibilidade Boolean  @default(true)
  locacoes       Locacao[]
}

model Locacao {
  id                    Int       @id @default(autoincrement())
  dataInicio            DateTime
  dataDevolucaoPrevista DateTime
  dataDevolucaoEfetiva  DateTime?
  valorTotal            Float?
  status                String    @default("ATIVA")

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  
  veiculoId Int
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id])
}